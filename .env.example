# ==============================================================================
# BlockFactor: Environment Configuration Template
# Copy this file to `.env` for local development.
# ==============================================================================

# Server Environment & Port
ENV=development
PORT=4001
LOG_LEVEL=debug

# PostgreSQL / PostGIS Connection String
# In Docker Compose, use host 'db' port '5432'; for local dev use 'localhost:5433'
DATABASE_URL=postgres://blockfactor:blockfactor_dev@localhost:5433/blockfactor?sslmode=disable

# Geocoding Service Configuration
# Phase 1: Public Nominatim endpoint
# Phase 2: Local self-hosted Nominatim container (http://localhost:8088)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=BlockFactor-Dev/1.0 (contact: admin@blockfactor.app)

# OpenTripPlanner 2 (OTP2) Service Endpoint
OTP_BASE_URL=http://localhost:4003

# External Commercial APIs
# Google Places API (New) Key - Required for Third Places caching
GOOGLE_PLACES_API_KEY=

# FCC National Broadband Map API
FCC_BROADBAND_API_BASE_URL=https://broadbandmap.fcc.gov/api/public

# Divvy GBFS (Micro-Mobility Live Feed)
DIVVY_GBFS_STATION_STATUS_URL=https://gbfs.lyft.com/gbfs/2.3/chi/en/station_status.json
DIVVY_GBFS_STATION_INFO_URL=https://gbfs.lyft.com/gbfs/2.3/chi/en/station_information.json

# Chicago Data Portal (Socrata) App Token — used by the seed CLI (cmd/seed)
# Optional in dev; unauthenticated SODA requests are heavily throttled
CHICAGO_APP_TOKEN=

# Web Frontend URL (for CORS and share preview redirects)
WEB_BASE_URL=http://localhost:4002
